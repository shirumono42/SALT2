# --- 必須 ---
ANTHROPIC_API_KEY=
SECRET_KEY=change-me-to-a-long-random-string
# 初期admin兼確認用アカウント（起動時に未作成なら自動作成）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
# --- 任意 ---
CLAUDE_MODEL=claude-fable-5-1
MAX_UPLOAD_MB=10
DATA_DIR=./data
# 招待メール(SMTP)。未設定の場合は認証コードを画面とコンソールに表示する
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
